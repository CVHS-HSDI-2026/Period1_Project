// ============================================================
// Prisma Schema
// Learn more: https://pris.ly/d/prisma-schema
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH MODELS
// ============================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255) // bcrypt hashed
  emailVerified DateTime?
  name          String?   @db.VarChar(100)
  image         String?   @db.VarChar(2048)

  student  Student?
  admin    Admin?
  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// DOMAIN MODELS
// ============================================================

model Student {
  id     String @id @default(uuid())
  userId String @unique

  graduationYear Int
  clubs          Club[]         @relation("StudentClubs")
  officerOf      Club[]         @relation("ClubOfficers")
  announcements  Announcement[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(150)
  description  String   @db.VarChar(2000)
  roomNumber   String   @db.VarChar(20)
  tags         String[]
  photoUrl     String   @db.VarChar(2048)
  signUpLink   String   @db.VarChar(2048)
  otherLinks   String[] @db.VarChar(2048)
  advisorName  String   @db.VarChar(64)
  advisorEmail String   @db.VarChar(128)
  officerEmail String[] @db.VarChar(128)
  status       Status   @default(PENDING)

  members       Student[]      @relation("StudentClubs")
  officers      Student[]      @relation("ClubOfficers")
  announcements Announcement[]
  meetings      Meeting[]
}

model Meeting {
  id         String   @id
  date       DateTime @db.Date
  time       DateTime @db.Time
  roomNumber String   @db.VarChar(20)
  notes      String?
  clubId     String

  club Club @relation(fields: [clubId], references: [id])
}

model Announcement {
  id       String @id @default(uuid())
  title    String @db.VarChar(200)
  content  String @db.VarChar(5000)
  images   String[] @db.VarChar(2048)
  clubId   String
  posterId String

  club   Club    @relation(fields: [clubId], references: [id])
  poster Student @relation(fields: [posterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ENUMS
// ============================================================

enum Status {
  APPROVED
  PENDING
  REJECTED
}
